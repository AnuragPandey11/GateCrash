# Copy to .env.local. See FRONTEND.md §13.1.
# Must be https outside local — the backend's StartupSecretsValidator refuses non-https CORS
# origins in prod, so a mixed-scheme setup fails at the *server*, confusingly.
VITE_API_URL=http://localhost:8080

# Optional crash reporting (§11.4). Leave blank to disable.
VITE_SENTRY_DSN=
