{
  "name": "@gatecrash/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "THE contract layer: ky client, error envelope, single-flight refresh, Zod boundary schemas, endpoints, query hooks, MSW handlers.",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./mocks": { "types": "./src/mocks/index.ts", "default": "./src/mocks/index.ts" }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "bash ../../tools/openapi/gen.sh"
  },
  "dependencies": {
    "@gatecrash/core": "workspace:*",
    "@tanstack/react-query": "5.59.20",
    "ky": "1.7.2",
    "zod": "3.23.8"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@gatecrash/config": "workspace:*",
    "@eslint/js": "9.14.0",
    "@types/react": "18.3.12",
    "eslint": "9.14.0",
    "msw": "2.6.4",
    "openapi-typescript": "7.4.2",
    "react": "18.3.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vitest": "2.1.4"
  }
}
