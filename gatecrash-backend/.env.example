# Copy to .env (or export into your shell) for local development.
# NEVER commit a real .env file — it is already in .gitignore.

# --- Database -----------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/gatecrash
DB_USER=gatecrash
DB_PASSWORD=gatecrash

# --- JWT ------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-32-bytes-min-in-prod-please

# --- Pass PIN pepper --------------------------------------------------------
# 16+ random bytes. Generate with: openssl rand -base64 32
# Rotating this invalidates PIN redemption for existing passes (QR still works).
PASS_PIN_PEPPER=change-me-pass-pin-pepper-32-bytes-min

# --- Bootstrap admin --------------------------------------------------------
# Required outside local/test profiles. Leave unset locally to get a one-time
# generated password logged at startup instead.
GATECRASH_BOOTSTRAP_ADMIN_PASSWORD=

# --- Firebase Cloud Messaging ------------------------------------------------
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS=classpath:firebase/service-account.json

# --- CORS -------------------------------------------------------------------
# Comma-separated allowlist. Must be https:// outside local/test.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Misc ---------------------------------------------------------------
SERVER_PORT=8080
